# Copy to `.env` and replace every placeholder. `.env` is git-ignored; never commit it.
# Passwords below are development placeholders only.

# --- Application ---
APP_NAME=RAG-Platform
APP_ENV=development            # development | test | staging | production
APP_DEBUG=false
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_to_a_random_string_of_at_least_32_characters
JWT_ALGORITHM=HS256            # HS256 | HS384 | HS512
JWT_ISSUER=rag-platform
JWT_AUDIENCE=rag-platform-users
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_COST_FACTOR=12          # must be >= 12 in staging/production

# Authentication rate limiting (fixed window, per client IP; per-account budget is 5x)
RATE_LIMIT_ENABLED=true        # must stay true in staging/production
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- File storage and uploads ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads   # host runs; Docker Compose uses a named volume at /data/uploads
MAX_UPLOAD_BYTES=52428800           # 50 MiB
RATE_LIMIT_UPLOAD_ATTEMPTS=20       # uploads per user per window
MAX_STORAGE_BYTES_PER_USER=1073741824  # 1 GiB total stored per user

# --- Document processing (Celery worker) ---
WORKER_CONCURRENCY=2                   # parallel processing tasks per worker container
WORKER_MEMORY_LIMIT=2g                 # hard memory cap for the worker container
PROCESSING_MAX_ATTEMPTS=3              # automatic attempts for transient failures
PROCESSING_RETRY_BACKOFF_SECONDS=30    # first retry delay; doubles each attempt (max 900)
PROCESSING_TIMEOUT_SECONDS=120         # time budget per document (hard kill at +45 s)
PROCESSING_MAX_PAGES=2000
PROCESSING_MAX_TEXT_CHARS=20000000     # extracted characters per document
PROCESSING_MAX_DOCX_UNCOMPRESSED_BYTES=209715200
PROCESSING_STALE_AFTER_SECONDS=300     # must exceed the hard time limit; abandoned work is recovered after this
PROCESSING_SWEEP_INTERVAL_SECONDS=60   # recovery sweep (Celery beat)
PROCESSING_PENDING_REQUEUE_AFTER_SECONDS=120

CHUNKING_MAX_CHARS=1000             # largest chunk, in characters (embedding-model friendly)
CHUNKING_OVERLAP_CHARS=150          # overlap, used only inside an oversized paragraph (max half of max)
CHUNKING_MIN_CHARS=20               # a smaller trailing chunk is merged into its predecessor
CHUNKING_MAX_CHUNKS=50000           # chunks per document; more fails the document safely

# --- Embeddings and semantic search ---------------------------------------------------------
# Default: multilingual-e5-small (384 dimensions, MIT, 94 languages including Bengali, about 0.5 GB,
# runs on CPU). The model is downloaded on first start into a shared volume, never into the image.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3   # full commit hash: required, pins the exact files
EMBEDDING_DIMENSION=384             # must equal the database vector width; another size needs a migration
EMBEDDING_QUERY_PREFIX="query: "    # e5 models need these prefixes; models without them use ""
EMBEDDING_PASSAGE_PREFIX="passage: "
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_INCLUDE_HEADING=false     # prepend the heading path to each chunk before embedding
EMBEDDING_BATCH_SIZE=8              # chunks per model call. CPU: 4-8 was fastest here; GPUs usually prefer larger (not measured)
EMBEDDING_DEVICE=auto               # auto | cpu | cuda | mps
EMBEDDING_TORCH_THREADS=            # empty: all cores
EMBEDDING_ALLOW_DOWNLOAD=true       # false = offline (the API container always runs with false)
EMBEDDING_CACHE_DIR=                # empty: HF_HOME
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BACKOFF_SECONDS=30
EMBEDDING_TASK_BUDGET_SECONDS=180   # a document is embedded over several tasks of this length
EMBEDDING_MODEL_LOAD_ALLOWANCE_SECONDS=120
EMBEDDING_STALE_AFTER_SECONDS=600   # must exceed the task hard limit; abandoned work is recovered after this
EMBEDDING_REQUEUE_AFTER_SECONDS=120
EMBEDDING_WORKER_MEMORY_LIMIT=3g
EMBEDDING_WORKER_CONCURRENCY=1

SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=50
SEARCH_MAX_QUERY_CHARS=1000
SEARCH_MAX_CONCURRENT_QUERIES=4     # simultaneous query embeddings per API process
SEARCH_QUERY_TIMEOUT_SECONDS=20
SEARCH_HNSW_EF_SEARCH=              # empty = exact search. Set only after adding an HNSW index (see docs)
HYBRID_DENSE_CANDIDATES=50          # candidates taken from vector search before fusion (1-200)
HYBRID_SPARSE_CANDIDATES=50         # candidates taken from full-text search before fusion (1-200)
HYBRID_RRF_K=60                     # Reciprocal Rank Fusion constant; larger = flatter rank weighting
HYBRID_DENSE_WEIGHT=1.0             # per-retriever fusion weights (0-10, not both zero)
HYBRID_SPARSE_WEIGHT=1.0
SPARSE_REMOVE_STOPWORDS=true         # drop English and Bengali function words from the lexical query (not from phrases)
SPARSE_STATEMENT_TIMEOUT_MS=2000      # the lexical query is cancelled after this long (that retriever is then reported as degraded)
SPARSE_MAX_TERMS=12                 # most distinctive (highest-IDF) query terms used by the full-text retriever
# Reranking (Phase 8): off by default. When enabled, POST /search/hybrid accepts "rerank": true.
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e   # full commit hash: required, pins the exact files
RERANK_DEVICE=auto                  # auto | cpu | cuda | mps
RERANK_BATCH_SIZE=8                 # query-passage pairs per model call
RERANK_CANDIDATES=10                # hybrid candidates re-scored by default
RERANK_MAX_CANDIDATES=100           # hard upper bound a request may ask for
RERANK_MAX_LENGTH=512               # tokens of query + passage; longer passages lose their end (flagged per result)
RERANK_TIMEOUT_SECONDS=20           # scoring budget; on timeout the hybrid order is kept and reported
RERANK_LOAD_TIMEOUT_SECONDS=120     # extra allowance for the first model load
RERANK_MAX_CONCURRENT=1             # simultaneous scorings per API process
RERANK_PRELOAD=true                 # load the model in the background at start-up when enabled
RERANK_CACHE_DIR=                   # empty: HF_HOME
RERANK_ALLOW_DOWNLOAD=true          # false = offline (the API container always runs with false)
RERANK_TORCH_THREADS=               # empty: all cores
# Answer generation / RAG (Phase 9): off by default. When enabled, POST /api/v1/rag/answer is available.
# Retrieved passages and the question are sent to the model at LLM_BASE_URL: keep it local (Ollama,
# LM Studio) unless you intend to send document text to a hosted API.
RAG_ENABLED=false
LLM_PROVIDER=ollama                  # ollama | openai_compatible (OpenAI, LM Studio, vLLM, ...)
LLM_BASE_URL=http://localhost:11434  # in Docker use http://host.docker.internal:11434 (Ollama must listen there)
LLM_MODEL=qwen3.5:9b                 # a model already pulled into the provider; the application never downloads one
LLM_API_KEY=                         # only for hosted endpoints; never commit it; never sent over plain http to a remote host
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=400
LLM_CONTEXT_TOKENS=4096              # the window the provider is told to use; budgets below must fit in it
LLM_TIMEOUT_SECONDS=120              # CPU-only local models can be slow: measure before lowering
LLM_MAX_CONCURRENT=1                 # simultaneous generations per API process
LLM_STRUCTURED_OUTPUT=json_schema    # json_schema | json_object | none (the output is always validated locally)
RAG_RETRIEVAL_MODE=hybrid            # hybrid | semantic
RAG_CANDIDATES=10                    # chunks retrieved (and optionally reranked) before selection
RAG_MAX_SOURCES=5                    # chunks shown to the model
RAG_MAX_CHUNK_TOKENS=600             # per-source limit (estimated); longer chunks are cut and flagged
RAG_CONTEXT_TOKEN_BUDGET=2400        # total estimated tokens of source text
RAG_QUEUE_TIMEOUT_SECONDS=15         # how long a request waits for a free generation slot
RATE_LIMIT_RAG_ATTEMPTS=10           # answers per user per window
# Conversations (Phase 10): persistent, user-owned; answers use the RAG settings above
CONVERSATION_HISTORY_TURNS=4  # previous exchanges offered to the model as untrusted context
CONVERSATION_HISTORY_TOKEN_BUDGET=400  # estimated tokens of history in a prompt
CONVERSATION_HISTORY_MESSAGE_TOKENS=150  # per history message limit (estimated)
CONVERSATION_FOLLOWUP_MAX_WORDS=8  # shorter questions are retrieved together with the previous question
CONVERSATION_RETRIEVAL_CONTEXT_TURNS=1  # previous questions added to a short follow-up's retrieval query
CONVERSATION_MAX_PER_USER=1000  # conversations per user
CONVERSATION_MAX_MESSAGES=400  # messages per conversation
CONVERSATION_PROCESSING_STALE_SECONDS=480  # an unfinished question older than this is marked interrupted; must exceed the slowest turn
RATE_LIMIT_CONVERSATION_MESSAGES=10  # conversation answers per user per window
RATE_LIMIT_CONVERSATION_MANAGE=120  # conversation create/list/read/rename/delete per user per window
RATE_LIMIT_SEARCH_ATTEMPTS=60       # searches per user per window

WORKER_MAX_TASKS_PER_CHILD=50
WORKER_MAX_MEMORY_PER_CHILD_KB=1000000 # recycle a worker process above ~1 GB

# Comma-separated explicit origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173

# --- Docker Compose service credentials (used by docker-compose.yml) ---
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_this_dev_password
POSTGRES_DB=rag_db
REDIS_PASSWORD=change_this_dev_password

# --- Application connection URLs ---
# Used when running the backend/tests on the host. Inside Docker Compose these
# are rebuilt from the POSTGRES_* / REDIS_PASSWORD values above, using service hostnames.
# Keep the passwords here identical to the ones above.
DATABASE_URL=postgresql+asyncpg://rag_user:change_this_dev_password@localhost:5432/rag_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://:change_this_dev_password@localhost:6379/0
CELERY_BROKER_URL=redis://:change_this_dev_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:change_this_dev_password@localhost:6379/2

# --- Host ports (all bound to 127.0.0.1 only) ---
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
