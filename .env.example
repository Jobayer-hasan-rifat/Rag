# Environment Variables

# Application
APP_NAME=RAG-Platform
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE_URL=postgresql+asyncpg://rag_user:change_this_password@localhost:5432/rag_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change_this_to_a_very_long_random_string_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_COST_FACTOR=12

# JWT
JWT_ALGORITHM=HS256
JWT_ISSUER=rag-platform
JWT_AUDIENCE=rag-platform-users

# File Storage
STORAGE_BACKEND=local
STORAGE_PATH=/uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_FILE_TYPES=pdf,docx,txt,md

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=300
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Embedding Model
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=100
EMBEDDING_DIMENSION=384

# LLM Providers (Optional - at least one required for RAG)
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Default LLM Provider
LLM_PROVIDER=openai  # openai, anthropic, ollama

# RAG Configuration
RAG_TOP_K=10
RAG_MIN_SIMILARITY=0.7
RAG_MAX_CONTEXT_TOKENS=4000
RAG_RERANK_ENABLED=true

# Search Configuration
SEMANTIC_SEARCH_WEIGHT=0.6
KEYWORD_SEARCH_WEIGHT=0.4

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=20/minute

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOW_HEADERS=*

# Frontend (Optional)
FRONTEND_URL=http://localhost:3000

# Monitoring (Future)
# SENTRY_DSN=https://your-sentry-dsn
# PROMETHEUS_PORT=9090

# Development
TESTING=false
ENVIRONMENT=development
