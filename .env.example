# Copy to `.env` and replace every placeholder. `.env` is git-ignored; never commit it.
# Passwords below are development placeholders only.

# --- Application ---
APP_NAME=RAG-Platform
APP_ENV=development            # development | test | staging | production
APP_DEBUG=false
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_to_a_random_string_of_at_least_32_characters
JWT_ALGORITHM=HS256            # HS256 | HS384 | HS512
JWT_ISSUER=rag-platform
JWT_AUDIENCE=rag-platform-users
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_COST_FACTOR=12          # must be >= 12 in staging/production

# Authentication rate limiting (fixed window, per client IP; per-account budget is 5x)
RATE_LIMIT_ENABLED=true        # must stay true in staging/production
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- File storage and uploads ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads   # host runs; Docker Compose uses a named volume at /data/uploads
MAX_UPLOAD_BYTES=52428800           # 50 MiB
RATE_LIMIT_UPLOAD_ATTEMPTS=20       # uploads per user per window
MAX_STORAGE_BYTES_PER_USER=1073741824  # 1 GiB total stored per user

# Comma-separated explicit origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173

# --- Docker Compose service credentials (used by docker-compose.yml) ---
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_this_dev_password
POSTGRES_DB=rag_db
REDIS_PASSWORD=change_this_dev_password

# --- Application connection URLs ---
# Used when running the backend/tests on the host. Inside Docker Compose these
# are rebuilt from the POSTGRES_* / REDIS_PASSWORD values above, using service hostnames.
# Keep the passwords here identical to the ones above.
DATABASE_URL=postgresql+asyncpg://rag_user:change_this_dev_password@localhost:5432/rag_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://:change_this_dev_password@localhost:6379/0
CELERY_BROKER_URL=redis://:change_this_dev_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:change_this_dev_password@localhost:6379/2

# --- Host ports (all bound to 127.0.0.1 only) ---
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
