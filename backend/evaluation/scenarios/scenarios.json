                  "August"
                ]
              ],
              "texts_exclude": [
                "July"
              ],
              "versions_only": [
                "v2"
              ]
            }
          }
        },
        {
          "op": "search",
          "q": "When are Aman rice seedlings transplanted?",
          "rerank": true,
          "expect": {
            "hard": {
              "texts_exclude": [
                "July"
              ],
              "versions_only": [
                "v2"
              ]
            }
          }
        },
        {
          "op": "search",
